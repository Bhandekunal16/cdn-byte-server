{
  "storageUsagePipeline": [
    {
      "$group": {
        "_id": "$email",
        "imageCount": { "$sum": 1 },
        "totalStoredSize": { "$sum": { "$ifNull": ["$storedSize", "$size"] } }
      }
    },
    {
      "$project": {
        "_id": 0,
        "email": "$_id",
        "imageCount": 1,
        "totalStoredSize": 1
      }
    },
    { "$sort": { "totalStoredSize": -1, "email": 1 } }
  ],
  "ImageMetaDataPipe": { "projection": { "image": 0 } },
  "imageDataPipe": {
    "projection": {
      "image": 1,
      "mimeType": 1,
      "type": 1,
      "storedSize": 1,
      "checksum": 1,
      "_id": 0
    }
  }
}
